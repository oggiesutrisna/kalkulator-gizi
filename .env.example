# Database connection string
# SQLite (libSQL) - local file (default):
DATABASE_URL=file:./dev.db
# SQLite - Turso remote (Vercel demo/preview/production):
# DATABASE_URL=libsql://your-db-username.turso.io
# TURSO_AUTH_TOKEN=eyJ...
# Alternative generic token env:
# DATABASE_AUTH_TOKEN=eyJ...

# Optional path to TKPI Excel file (defaults to scanning workspace)
TKPI_XLSX_PATH=./EXCEL PERHITUNGAN NILAI GIZI TKPI 2020.xlsx

# Optional demo/presentation mode (client-side, presentation-only)
# NEXT_PUBLIC_APP_ENV=demo
# NEXT_PUBLIC_DEMO_MODE=true
